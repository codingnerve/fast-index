# --- Core ---
# Production uses MongoDB Atlas (free M0 tier). The prisma datasource provider
# is already set to "mongodb". Put your DB name (e.g. indexfast) before the "?".
# See DEPLOY.md for the full walkthrough.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/indexfast?retryWrites=true&w=majority"
# Secret used to sign session JWTs. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Free mode ---
# Default is ON: unlimited indexing, no credits, no payments. Set to "false"
# only if you want to re-enable the paid credit system + Razorpay.
# FREE_MODE="false"

# --- IndexNow (Bing, Yandex, Seznam, Naver) ---
# 8-128 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Without it, IndexNow runs in simulation mode (no real submission).
INDEXNOW_KEY=""
# The app serves the key file automatically at /api/indexnow-key — just point
# this to that URL once deployed, e.g. https://yourdomain.com/api/indexnow-key
INDEXNOW_KEY_LOCATION=""

# --- Google Indexing API (OPTIONAL, gray-area: officially JobPosting/BroadcastEvent only) ---
# Paste the full service-account JSON on one line, or leave blank to disable.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# --- Razorpay payments (NOT needed in free mode — leave blank) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
