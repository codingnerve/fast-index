generator client {
  provider = "prisma-client-js"
}

datasource db {
  // MongoDB Atlas (free M0 tier). Atlas runs as a replica set, which is
  // required for Prisma's $transaction (used in src/lib/engine.ts).
  // DATABASE_URL is a mongodb+srv://... connection string.
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid()) @map("_id")
  email        String   @unique
  passwordHash String
  name         String?
  credits      Int      @default(10) // free trial credits on signup
  createdAt    DateTime @default(now())

  jobs         IndexJob[]
  transactions CreditTransaction[]
  payments     Payment[]
  apiKeys      ApiKey[]
}

model ApiKey {
  id         String    @id @default(cuid()) @map("_id")
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String    @default("Default")
  prefix     String // first 12 chars, shown in UI for identification
  hash       String    @unique // sha256 of the full key; full key shown once
  revoked    Boolean   @default(false)
  lastUsedAt DateTime?
  requests   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model IndexJob {
  id           String   @id @default(cuid()) @map("_id")
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source       String   @default("paste") // paste | csv | api
  engine       String   @default("indexnow") // indexnow | google | both
  total        Int      @default(0)
  submitted    Int      @default(0)
  indexed      Int      @default(0)
  failed       Int      @default(0)
  duplicates   Int      @default(0)
  invalid      Int      @default(0)
  creditsSpent Int      @default(0)
  status       String   @default("processing") // processing | done | error
  createdAt    DateTime @default(now())

  urls IndexUrl[]

  @@index([userId])
}

model IndexUrl {
  id        String   @id @default(cuid()) @map("_id")
  jobId     String
  job       IndexJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url       String
  // pending | submitted | indexed | failed | duplicate | invalid
  status    String   @default("pending")
  engine    String   @default("indexnow")
  message   String?
  createdAt DateTime @default(now())

  @@index([jobId])
}

model CreditTransaction {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // positive = credit purchased/granted, negative = spent
  reason    String // signup_bonus | purchase | indexing | refund
  createdAt DateTime @default(now())

  @@index([userId])
}

model Payment {
  id                String   @id @default(cuid()) @map("_id")
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String // starter | professional | enterprise
  amountPaise       Int // amount in paise (₹1 = 100)
  credits           Int
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  status            String   @default("created") // created | paid | failed
  createdAt         DateTime @default(now())

  @@index([userId])
}
